  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "build": "prisma generate && tsc",
    "db:check": "npm run build && node dist/scripts/check-db.js",
    "start": "node dist/server.js",
    "test": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "npm test -- --coverage",
    "test:integration": "npm run build && node scripts/run-db-tests.mjs",
    "test:redis": "npm run build && node scripts/run-redis-tests.mjs",
    "test:cache": "npm run build && node scripts/run-cache-tests.mjs",
    "benchmark:cache": "npm run build && node scripts/run-cache-tests.mjs benchmark"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.23.1",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
