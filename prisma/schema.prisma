generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum RoomStatus {
  OPEN
  FINALIZED
}

enum ParticipantRole {
  HOST
  MEMBER
}

enum OAuthProvider {
  GOOGLE
  NAVER
  KAKAO
}

model Room {
  id                   String     @id @default(uuid()) @db.Uuid
  name                 String     @db.VarChar(40)
  description          String     @default("") @db.VarChar(300)
  status               RoomStatus @default(OPEN)
  inviteTokenHash      String     @unique @db.VarChar(64)
  finalizedCandidateId String?    @db.Uuid
  finalizedAt          DateTime?  @db.Timestamptz(3)
  meetingDate          DateTime?  @db.Date
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @db.Timestamptz(3)

  participants Participant[]
  candidates   PlaceCandidate[] @relation("RoomCandidates")

  finalizedCandidate PlaceCandidate? @relation("FinalizedCandidate", fields: [id, finalizedCandidateId], references: [roomId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([meetingDate])
  @@map("rooms")
}

model Participant {
  id        String          @id @default(uuid()) @db.Uuid
  roomId    String          @db.Uuid
  userId    String?         @db.Uuid
  nickname  String          @db.VarChar(12)
  role      ParticipantRole @default(MEMBER)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  room       Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessions   ParticipantSession[]
  candidates PlaceCandidate[]
  vote       PlaceVote?

  @@unique([roomId, id])
  @@unique([roomId, userId])
  // 방장 중복 방지용 부분 유니크 인덱스는 migration.sql에서 관리합니다.
  @@index([roomId])
  @@index([userId])
  @@map("participants")
}

model ParticipantSession {
  id            String   @id @default(uuid()) @db.Uuid
  participantId String   @db.Uuid
  tokenHash     String   @unique @db.VarChar(64)
  expiresAt     DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@index([expiresAt])
  @@map("participant_sessions")
}

model PlaceCandidate {
  id          String   @id @default(uuid()) @db.Uuid
  roomId      String   @db.Uuid
  createdById String   @db.Uuid
  name        String   @db.VarChar(100)
  address     String   @db.VarChar(200)
  mapUrl      String?  @db.VarChar(2000)
  memo        String   @default("") @db.VarChar(300)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  room         Room            @relation("RoomCandidates", fields: [roomId], references: [id], onDelete: Cascade)
  createdBy    Participant     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  votes        PlaceVote[]
  finalizedFor Room[]          @relation("FinalizedCandidate")
  menus        CandidateMenu[]

  @@unique([roomId, id])
  @@index([roomId, createdAt, id])
  @@index([createdById])
  @@map("place_candidates")
}

model PlaceVote {
  roomId        String   @db.Uuid
  participantId String   @db.Uuid
  candidateId   String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  participant Participant    @relation(fields: [roomId, participantId], references: [roomId, id], onDelete: Cascade, onUpdate: Cascade)
  candidate   PlaceCandidate @relation(fields: [roomId, candidateId], references: [roomId, id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roomId, participantId])
  @@index([roomId, candidateId])
  @@map("place_votes")
}

model CandidateMenu {
  id          String   @id @default(uuid()) @db.Uuid
  candidateId String   @db.Uuid
  name        String   @db.VarChar(100)
  price       Int?
  priceBasis  String   @db.VarChar(30)
  position    Int      @db.SmallInt
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  candidate PlaceCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, position])
  @@map("candidate_menus")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  nickname  String   @db.VarChar(12)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  localCredential LocalCredential?
  oauthAccounts   OAuthAccount[]
  sessions        UserSession[]
  participations  Participant[]

  @@map("users")
}

model LocalCredential {
  userId       String   @id @db.Uuid
  loginId      String   @unique @db.VarChar(30)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("local_credentials")
}

model OAuthAccount {
  provider          OAuthProvider
  providerAccountId String        @db.VarChar(255)
  userId            String        @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("oauth_accounts")
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}
