generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum RoomStatus {
  OPEN
  FINALIZED
}

enum ParticipantRole {
  HOST
  MEMBER
}

model Room {
  id              String     @id @default(uuid()) @db.Uuid
  name            String     @db.VarChar(40)
  description     String     @default("") @db.VarChar(300)
  status          RoomStatus @default(OPEN)
  inviteTokenHash String     @unique @db.VarChar(64)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  participants Participant[]
  candidates   PlaceCandidate[]

  @@map("rooms")
}

model Participant {
  id        String          @id @default(uuid()) @db.Uuid
  roomId    String          @db.Uuid
  nickname  String          @db.VarChar(12)
  role      ParticipantRole @default(MEMBER)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  room       Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sessions   ParticipantSession[]
  candidates PlaceCandidate[]
  vote       PlaceVote?

  @@unique([roomId, id])
  // 방장 중복 방지용 부분 유니크 인덱스는 migration.sql에서 관리합니다.
  @@index([roomId])
  @@map("participants")
}

model ParticipantSession {
  id            String   @id @default(uuid()) @db.Uuid
  participantId String   @db.Uuid
  tokenHash     String   @unique @db.VarChar(64)
  expiresAt     DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@index([expiresAt])
  @@map("participant_sessions")
}

model PlaceCandidate {
  id          String   @id @default(uuid()) @db.Uuid
  roomId      String   @db.Uuid
  createdById String   @db.Uuid
  name        String   @db.VarChar(100)
  address     String   @db.VarChar(200)
  mapUrl      String?  @db.VarChar(2000)
  memo        String   @default("") @db.VarChar(300)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  room      Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy Participant @relation(fields: [createdById], references: [id], onDelete: Restrict)
  votes     PlaceVote[]

  @@unique([roomId, id])
  @@index([roomId, createdAt, id])
  @@index([createdById])
  @@map("place_candidates")
}

model PlaceVote {
  roomId        String   @db.Uuid
  participantId String   @db.Uuid
  candidateId   String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  participant Participant    @relation(fields: [roomId, participantId], references: [roomId, id], onDelete: Cascade, onUpdate: Cascade)
  candidate   PlaceCandidate @relation(fields: [roomId, candidateId], references: [roomId, id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roomId, participantId])
  @@index([roomId, candidateId])
  @@map("place_votes")
}
